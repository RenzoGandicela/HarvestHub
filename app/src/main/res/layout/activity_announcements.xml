<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFF8DC"
    android:layout_marginBottom="16dp"
    android:elevation="4dp"
    android:backgroundTint="#FFFFFF"
    android:clipToOutline="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/featured_background"
            android:layout_width="170dp"
            android:layout_height="280dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E6E4CE"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/aoboshi_one"
                android:text="Community Cooking Events"
                android:textAllCaps="true"
                android:textColor="#1F6722"
                android:textSize="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:fontFamily="@font/aoboshi_one"
                android:text="Join an event and cook for the community!"
                android:textColor="#5B8C5D" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/featured_recycler"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_toRightOf="@+id/featured_background"
            android:background="#F4F4F2">

        </androidx.recyclerview.widget.RecyclerView>
    </RelativeLayout>
</LinearLayout>